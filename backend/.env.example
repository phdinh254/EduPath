# Copy this file to .env and adjust as needed. Never commit the real .env file.

# Khi chạy local (backend chạy trực tiếp trên máy, Postgres qua Docker Compose port 5432)
DATABASE_URL="postgresql://edupath:edupath@localhost:5432/edupath?schema=public"
# Khi chạy toàn bộ qua Docker Compose, docker-compose.yml đã tự override thành:
# postgresql://edupath:edupath@postgres:5432/edupath?schema=public

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# Redis cho hàng đợi BullMQ (chấm tự luận/sinh câu hỏi/lời khuyên AI chạy
# nền). Khi chạy qua Docker Compose, REDIS_HOST tự override thành "redis".
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# "production" bật cookie refreshToken với flag Secure (chỉ gửi qua HTTPS) —
# để trống/"development" khi chạy local qua HTTP thuần.
NODE_ENV="development"

# Đăng nhập bằng Google (tuỳ chọn). Lấy Client ID/Secret tại
# https://console.cloud.google.com/apis/credentials — tạo "OAuth client ID"
# loại "Web application", thêm GOOGLE_CALLBACK_URL vào "Authorized redirect URIs".
# Nếu để trống, endpoint /auth/google trả lỗi 503 rõ ràng thay vì crash server.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# URL frontend để redirect về sau khi đăng nhập Google thành công (kèm một mã
# dùng một lần qua query string — KHÔNG phải token thật, xem AuthController.googleCallback)
FRONTEND_URL="http://localhost:5173"

# AI thật (Google Gemini) cho chấm Văn, sinh câu hỏi, giải thích câu sai, lời
# khuyên ôn tập. Lấy API key tại https://aistudio.google.com/apikey — để
# trống thì hệ thống tự dùng lại logic rule-based/mẫu có sẵn (không lỗi).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Giới hạn số lượt gọi Gemini thật/ngày (chống chi phí vượt tầm kiểm soát do
# bug/lạm dụng) và timeout mỗi lượt gọi (ms) — vượt ngưỡng thì tự rơi về
# fallback rule-based sẵn có, không chặn cứng request. Để trống dùng mặc định
# (300 lượt/ngày, timeout 20000ms).
GEMINI_DAILY_BUDGET="300"
GEMINI_TIMEOUT_MS="20000"
