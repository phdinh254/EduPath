// EduPath — schema cơ sở dữ liệu chính
// Xem docs/PROJECT.md để biết đầy đủ ngữ cảnh nghiệp vụ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

// B2C thuần: học sinh tự chọn đề thi và ôn tập, không qua lớp học/trung tâm.
// ADMIN quản lý toàn bộ nội dung hệ thống (không tự đăng ký công khai được).
enum Role {
  STUDENT
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE // trắc nghiệm nhiều lựa chọn, 0.25đ/câu
  TRUE_FALSE // đúng/sai, thang điểm lũy tiến theo số ý đúng
  SHORT_ANSWER // trắc nghiệm trả lời ngắn
  ESSAY // tự luận (Ngữ văn), chấm qua luồng AI riêng
}

enum DifficultyLevel {
  KNOWLEDGE // nhận biết
  COMPREHENSION // thông hiểu
  APPLICATION // vận dụng
  HIGH_APPLICATION // vận dụng cao
}

// PENDING_APPROVAL: AI vừa sinh, chờ ADMIN duyệt nội dung/bản quyền.
// APPROVED: đã vào kho dùng chung, dùng được trong đề thi.
// REJECTED: bị admin từ chối/rút khỏi kho dùng chung.
enum ContentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamCategory {
  THPT // Thi tốt nghiệp THPT quốc gia — 1 môn/đề, thang điểm 10
  DGNL // Đánh giá năng lực — nhiều môn/section trong 1 đề, thang điểm 150
}

// ---------- Core: User ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  dateOfBirth  DateTime?
  isActive     Boolean   @default(true)

  createdQuestions Question[]      @relation("QuestionCreatedBy")
  createdExams     Exam[]          @relation("ExamCreatedBy")
  examAttempts     ExamAttempt[]
  scoreOverrides   ScoreOverride[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Subjects / Topics / Questions ----------

model Subject {
  id   String @id @default(cuid())
  code String @unique
  name String

  topics    Topic[]
  questions Question[]
  exams     Exam[]

  createdAt DateTime @default(now())
}

model Topic {
  id            String  @id @default(cuid())
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name          String
  parentTopicId String?
  parentTopic   Topic?  @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childTopics   Topic[] @relation("TopicHierarchy")

  questions Question[]

  createdAt DateTime @default(now())

  @@index([subjectId])
}

// Ngân hàng câu hỏi dùng chung toàn hệ thống (không còn phạm vi riêng theo
// giáo viên/trung tâm) — status=APPROVED nghĩa là dùng được trong đề thi.
model Question {
  id         String          @id @default(cuid())
  subjectId  String
  subject    Subject         @relation(fields: [subjectId], references: [id])
  topicId    String
  topic      Topic           @relation(fields: [topicId], references: [id])
  type       QuestionType
  difficulty DifficultyLevel
  content    String
  // Đáp án lựa chọn (multiple choice / true-false), null với short answer/essay
  options       Json?
  // Đáp án đúng, cấu trúc tuỳ theo `type`
  correctAnswer Json?
  explanation   String?

  createdById String
  createdBy   User   @relation("QuestionCreatedBy", fields: [createdById], references: [id])

  status ContentStatus @default(PENDING_APPROVAL)
  // Lý do admin từ chối đề xuất (status=REJECTED)
  rejectReason String?

  examQuestions ExamQuestion[]
  answers       Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, topicId])
  @@index([status])
}

// ---------- Exams ----------

model Exam {
  id       String       @id @default(cuid())
  title    String
  category ExamCategory @default(THPT)
  // Bắt buộc với đề THPT (1 môn/đề). Đề ĐGNL gồm nhiều môn theo từng section
  // nên để null ở cấp đề, môn học được xác định theo từng câu hỏi/section.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdById     String
  createdBy       User    @relation("ExamCreatedBy", fields: [createdById], references: [id])
  durationMinutes Int

  sections      ExamSection[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

// Chỉ dùng cho đề ĐGNL: chia đề thành nhiều phần thi (vd. Tư duy định lượng,
// Tư duy định tính, Khoa học), mỗi phần có thang điểm riêng, tổng = 150.
model ExamSection {
  id       String @id @default(cuid())
  examId   String
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  name     String
  order    Int
  maxScore Float

  examQuestions ExamQuestion[]

  @@index([examId])
}

// Join table: một câu hỏi có thể được tái sử dụng ở nhiều đề với thứ tự/điểm khác nhau.
model ExamQuestion {
  id         String       @id @default(cuid())
  examId     String
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id])
  // Chỉ có giá trị với đề ĐGNL — câu hỏi thuộc section nào.
  sectionId  String?
  section    ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  order      Int
  maxScore   Float

  @@unique([examId, questionId])
  @@index([examId])
  @@index([sectionId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  totalScore  Float?

  answers          Answer[]
  score            Score?
  weaknessAnalyses WeaknessAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([studentId])
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])

  // Câu trả lời của học sinh, cấu trúc tuỳ theo loại câu hỏi
  response Json?

  // Chấm tự động (trắc nghiệm/đúng-sai/trả lời ngắn)
  isCorrect    Boolean?
  scoreAwarded Float?

  // Chấm bằng AI, công bố ngay lập tức (tự luận Ngữ văn) — luôn gắn nhãn
  // "điểm tham khảo do AI đánh giá" (isAiReferenceOnly=true).
  aiPreliminaryScore Float?
  aiComment          String?
  isAiReferenceOnly  Boolean @default(false)

  // Giải thích AI cho câu trắc nghiệm/đúng-sai/trả lời ngắn bị sai — sinh và
  // lưu (cache) lần đầu học sinh yêu cầu, không tính sẵn lúc chấm để không
  // làm chậm việc nộp bài.
  aiExplanation String?

  scoreOverride ScoreOverride?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ADMIN điều chỉnh lại điểm AI đã công bố cho câu tự luận (hậu kiểm chất lượng).
model ScoreOverride {
  id              String   @id @default(cuid())
  answerId        String   @unique
  answer          Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [id])
  originalAiScore Float?
  finalScore      Float
  comment         String?
  reviewedAt      DateTime @default(now())
}

// Điểm tổng hợp của một lượt làm bài, kèm phân tích theo chuyên đề để làm đầu vào cho AI
model Score {
  id         String      @id @default(cuid())
  attemptId  String      @unique
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalScore Float
  // Tỷ lệ đúng theo topic/chuyên đề: { topicId: { correct, total, subjectId } }
  topicBreakdown Json
  gradedAt       DateTime @default(now())
}

// ---------- AI cá nhân hóa ----------

model WeaknessAnalysis {
  id        String       @id @default(cuid())
  studentId String
  subjectId String
  attemptId String?
  attempt   ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  // Danh sách chuyên đề yếu kèm chi tiết (tỷ lệ đúng, dạng câu hay sai, ...)
  weakTopics Json
  details    Json?

  generatedAt DateTime @default(now())

  @@index([studentId, subjectId])
}

model StudyRoadmap {
  id        String        @id @default(cuid())
  studentId String
  subjectId String
  status    RoadmapStatus @default(ACTIVE)

  // Các giai đoạn ôn tập: [{ topicId, stage, resourceType, status }, ...]
  stages Json

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, subjectId])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
