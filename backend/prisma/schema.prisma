// EduPath — schema cơ sở dữ liệu chính
// Xem docs/PROJECT.md để biết đầy đủ ngữ cảnh nghiệp vụ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

// B2C thuần: học sinh tự chọn đề thi và ôn tập, không qua lớp học/trung tâm.
// ADMIN quản lý toàn bộ nội dung hệ thống (không tự đăng ký công khai được).
enum Role {
  STUDENT
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE // trắc nghiệm nhiều lựa chọn, 0.25đ/câu
  TRUE_FALSE // đúng/sai, thang điểm lũy tiến theo số ý đúng
  SHORT_ANSWER // trắc nghiệm trả lời ngắn
  ESSAY // tự luận (Ngữ văn), chấm qua luồng AI riêng
}

enum DifficultyLevel {
  KNOWLEDGE // nhận biết
  COMPREHENSION // thông hiểu
  APPLICATION // vận dụng
  HIGH_APPLICATION // vận dụng cao
}

// PENDING_APPROVAL: AI vừa sinh, chờ ADMIN duyệt nội dung/bản quyền.
// APPROVED: đã vào kho dùng chung, dùng được trong đề thi.
// REJECTED: bị admin từ chối/rút khỏi kho dùng chung.
enum ContentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Thứ tự khai báo quyết định thứ tự ORDER BY trên Postgres (kiểu enum gốc
// sắp xếp theo thứ tự khai báo, không phải theo alphabet) — IMPORTED_REAL
// đứng trước để pickOrSynthesizeQuestions/pickQuestionsByTopic ưu tiên chọn
// câu hỏi từ đề thật trước khi dùng câu AI tự sinh.
enum QuestionSource {
  IMPORTED_REAL // nhập từ đề thi thật (thi thử, đề chính thức các năm trước)
  ADMIN_MANUAL // admin tự soạn thủ công
  AI_GENERATED // AI tự sinh nội dung mới
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  // Đã nộp, nhưng có ít nhất 1 câu tự luận chưa được AI thật chấm nội dung
  // (Gemini lỗi/chưa cấu hình) — điểm CHƯA công bố, chờ ADMIN chấm tay qua
  // GradingService.reviewEssay trước khi chuyển sang GRADED.
  PENDING_REVIEW
  GRADED
}

enum OutboxStatus {
  PENDING
  PROCESSED
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamCategory {
  THPT // Thi tốt nghiệp THPT quốc gia — 1 môn/đề, thang điểm 10
  DGNL // Đánh giá năng lực — nhiều môn/section trong 1 đề, thang điểm 150
}

// PUBLIC: mọi học sinh đều thấy trong danh sách khám phá đề.
// PRIVATE: chỉ chính người tạo (createdById) thấy được — dùng cho đề luyện
// tập cá nhân do học sinh tự sinh, không được lẫn vào kho đề chung.
enum ExamVisibility {
  PUBLIC
  PRIVATE
}

// DRAFT: ADMIN đang soạn thủ công (create()), chưa đủ câu hỏi, chưa hiện với
// học sinh dù visibility=PUBLIC. PUBLISHED: sẵn sàng, hiện với học sinh.
// ARCHIVED: đã rút khỏi danh sách khám phá nhưng lịch sử làm bài cũ vẫn giữ.
enum ExamPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// OFFICIAL: đề chính thức của hệ thống (ADMIN tạo/ghép). PERSONAL_PRACTICE:
// đề học sinh tự sinh nhanh để luyện một chuyên đề (generateTopicPractice) —
// luôn đi kèm visibility=PRIVATE.
enum ExamPurpose {
  OFFICIAL
  PERSONAL_PRACTICE
}

// ---------- Core: User ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  dateOfBirth  DateTime?
  isActive     Boolean   @default(true)

  // Chống dò mật khẩu (brute-force) — tăng mỗi lần đăng nhập sai, reset về 0
  // khi đăng nhập đúng. Đạt ngưỡng (xem AuthService.MAX_FAILED_ATTEMPTS) thì
  // khoá tạm thời qua lockedUntil thay vì khoá vĩnh viễn.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Mốc thời gian học sinh xem thông báo lần gần nhất — dùng để tính thông
  // báo "lời khuyên AI mới" nào là mới so với lần xem trước, không cần bảng
  // Notification riêng.
  lastNotificationsReadAt DateTime?

  createdQuestions   Question[]          @relation("QuestionCreatedBy")
  createdExams       Exam[]              @relation("ExamCreatedBy")
  examAttempts       ExamAttempt[]
  examLikes          ExamLike[]
  scoreOverrides     ScoreOverride[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  readinessSnapshots ReadinessSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Subjects / Topics / Questions ----------

model Subject {
  id   String @id @default(cuid())
  code String @unique
  name String

  topics              Topic[]
  questions           Question[]
  exams               Exam[]
  examStructure       ExamStructure?
  dgnlTemplateSections DgnlTemplateSection[]

  createdAt DateTime @default(now())
}

// Cấu trúc đề cố định theo môn (THPT — 1 môn/đề): số câu theo từng dạng ×
// mức độ khó, dùng làm khuôn mỗi khi AI ghép đề cho môn này, thay vì admin
// phải tự gõ số lượng mỗi lần. Mỗi môn chỉ có đúng 1 cấu trúc tại một thời
// điểm (subjectId unique) — sửa cấu trúc áp dụng cho mọi đề ghép sau đó.
model ExamStructure {
  id              String @id @default(cuid())
  subjectId       String @unique
  subject         Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  durationMinutes Int

  items ExamStructureItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamStructureItem {
  id                  String          @id @default(cuid())
  structureId         String
  structure           ExamStructure   @relation(fields: [structureId], references: [id], onDelete: Cascade)
  type                QuestionType
  difficulty          DifficultyLevel
  questionCount       Int
  maxScorePerQuestion Float
  order               Int

  @@index([structureId])
}

// Mẫu đề ĐGNL dùng chung (vd. "ĐGNL chuẩn 2025"): danh sách section cố định
// (môn + số câu + thang điểm), tổng luôn 150 — admin khai báo một lần rồi
// tái dùng mỗi khi AI ghép đề ĐGNL, thay vì phải gõ lại section thủ công mỗi
// lần (xem ExamsService.generateDgnlExam). Khác với ExamStructure (gắn
// cứng theo 1 môn cho đề THPT), 1 mẫu ĐGNL có thể được dùng để ghép nhiều đề
// khác nhau (nhiều lần) mà không bị ràng buộc "duy nhất theo môn".
model DgnlTemplate {
  id   String @id @default(cuid())
  name String

  sections DgnlTemplateSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DgnlTemplateSection {
  id            String       @id @default(cuid())
  templateId    String
  template      DgnlTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  questionCount Int
  maxScore      Float
  order         Int

  @@index([templateId])
}

model Topic {
  id            String  @id @default(cuid())
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name          String
  parentTopicId String?
  parentTopic   Topic?  @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childTopics   Topic[] @relation("TopicHierarchy")

  questions Question[]

  createdAt DateTime @default(now())

  @@index([subjectId])
}

// Ngân hàng câu hỏi dùng chung toàn hệ thống (không còn phạm vi riêng theo
// giáo viên/trung tâm) — status=APPROVED nghĩa là dùng được trong đề thi.
model Question {
  id         String          @id @default(cuid())
  subjectId  String
  subject    Subject         @relation(fields: [subjectId], references: [id])
  topicId    String
  topic      Topic           @relation(fields: [topicId], references: [id])
  type       QuestionType
  difficulty DifficultyLevel
  content    String
  // Đáp án lựa chọn (multiple choice / true-false), null với short answer/essay
  options       Json?
  // Đáp án đúng, cấu trúc tuỳ theo `type`
  correctAnswer Json?
  explanation   String?

  createdById String
  createdBy   User   @relation("QuestionCreatedBy", fields: [createdById], references: [id])

  status ContentStatus @default(PENDING_APPROVAL)
  // Lý do admin từ chối đề xuất (status=REJECTED)
  rejectReason String?

  // Nguồn gốc nội dung — mặc định ADMIN_MANUAL vì phần lớn dữ liệu hiện có
  // (seed-question-bank.ts) là tự biên soạn thủ công, không phải AI sinh.
  source QuestionSource @default(ADMIN_MANUAL)

  // Chỉ có giá trị khi source=AI_GENERATED — model thực sự sinh nội dung này
  // (vd. "gemini-flash-latest", hoặc "RULE_BASED_TEMPLATE" khi Gemini không
  // khả dụng lúc sinh) và phiên bản prompt, để truy vết/đánh giá chất lượng.
  generationModel        String?
  generationPromptVersion String?

  examQuestions ExamQuestion[]
  answers       Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, topicId])
  @@index([status])
}

// ---------- Exams ----------

model Exam {
  id       String       @id @default(cuid())
  title    String
  category ExamCategory @default(THPT)
  // Bắt buộc với đề THPT (1 môn/đề). Đề ĐGNL gồm nhiều môn theo từng section
  // nên để null ở cấp đề, môn học được xác định theo từng câu hỏi/section.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdById     String
  createdBy       User    @relation("ExamCreatedBy", fields: [createdById], references: [id])
  durationMinutes Int

  visibility ExamVisibility    @default(PUBLIC)
  status     ExamPublishStatus @default(PUBLISHED)
  purpose    ExamPurpose       @default(OFFICIAL)

  sections      ExamSection[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]
  likes         ExamLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([visibility, status])
}

// Học sinh "thích" một đề thi — dùng để hiển thị lượt thích khi khám phá đề,
// không ảnh hưởng đến việc làm bài.
model ExamLike {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([examId])
}

// Chỉ dùng cho đề ĐGNL: chia đề thành nhiều phần thi (vd. Tư duy định lượng,
// Tư duy định tính, Khoa học), mỗi phần có thang điểm riêng, tổng = 150.
model ExamSection {
  id       String @id @default(cuid())
  examId   String
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  name     String
  order    Int
  maxScore Float

  examQuestions ExamQuestion[]

  @@index([examId])
}

// Join table: một câu hỏi có thể được tái sử dụng ở nhiều đề với thứ tự/điểm khác nhau.
model ExamQuestion {
  id         String       @id @default(cuid())
  examId     String
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id])
  // Chỉ có giá trị với đề ĐGNL — câu hỏi thuộc section nào.
  sectionId  String?
  section    ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  order      Int
  maxScore   Float

  @@unique([examId, questionId])
  @@index([examId])
  @@index([sectionId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  totalScore  Float?

  answers          Answer[]
  score            Score?
  weaknessAnalyses WeaknessAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([studentId])
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])

  // Câu trả lời của học sinh, cấu trúc tuỳ theo loại câu hỏi
  response Json?

  // Tổng thời gian (giây) học sinh dừng ở câu này trong lúc làm bài — tích
  // lũy dần qua các lần lưu (frontend gửi phần chênh lệch mỗi lần chuyển
  // câu), dùng để phát hiện câu/chuyên đề học sinh mất nhiều thời gian bất
  // thường, không chỉ dựa vào tỷ lệ đúng/sai.
  timeSpentSeconds Int @default(0)

  // Chấm tự động (trắc nghiệm/đúng-sai/trả lời ngắn)
  isCorrect    Boolean?
  scoreAwarded Float?

  // Chấm bằng AI, công bố ngay lập tức (tự luận Ngữ văn) — luôn gắn nhãn
  // "điểm tham khảo do AI đánh giá" (isAiReferenceOnly=true).
  aiPreliminaryScore Float?
  aiComment          String?
  isAiReferenceOnly  Boolean @default(false)

  // Câu tự luận mà Gemini không chấm được nội dung thật (chưa cấu hình hoặc
  // lỗi) — scoreAwarded/aiPreliminaryScore để null, KHÔNG công bố điểm, chờ
  // ADMIN chấm tay qua ScoreOverride. Xem GradingService.gradeEssay.
  needsManualGrading Boolean @default(false)
  // Lý do rơi về chấm thủ công: GEMINI_NOT_CONFIGURED | GEMINI_ERROR
  fallbackReason String?
  // Model Gemini thực sự dùng để chấm câu này (vd. "gemini-flash-latest"),
  // null nếu chấm bằng rule-based (trắc nghiệm) hoặc đang chờ chấm tay.
  gradingModel String?
  // Phiên bản prompt chấm tự luận — tăng mỗi khi sửa nội dung prompt để có
  // thể truy vết điểm cũ được chấm bằng bản prompt nào.
  gradingPromptVersion String?
  // Thời điểm câu này thực sự được chấm xong (AI thành công hoặc ADMIN chấm tay).
  gradedAt DateTime?

  // Giải thích AI cho câu trắc nghiệm/đúng-sai/trả lời ngắn bị sai — sinh và
  // lưu (cache) lần đầu học sinh yêu cầu, không tính sẵn lúc chấm để không
  // làm chậm việc nộp bài.
  aiExplanation String?

  scoreOverride ScoreOverride?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// Đảm bảo việc phát job chấm tự luận qua Redis/BullMQ sống sót qua lỗi
// Redis hoặc lỗi tiến trình xảy ra giữa lúc nộp bài — ghi trong CÙNG
// transaction với các upsert Answer khác (xem GradingService.submitAttempt),
// enqueue thật sự CHỈ sau khi transaction đó commit. jobId trùng với jobId
// BullMQ tương ứng nên OutboxSweepProcessor phát lại một sự kiện PENDING
// không bao giờ tạo job trùng (BullMQ tự chặn theo jobId).
model OutboxEvent {
  id          String       @id @default(cuid())
  jobId       String       @unique
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

// ADMIN điều chỉnh lại điểm AI đã công bố cho câu tự luận (hậu kiểm chất lượng).
model ScoreOverride {
  id              String   @id @default(cuid())
  answerId        String   @unique
  answer          Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [id])
  originalAiScore Float?
  finalScore      Float
  comment         String?
  reviewedAt      DateTime @default(now())
}

// Điểm tổng hợp của một lượt làm bài, kèm phân tích theo chuyên đề để làm đầu vào cho AI
model Score {
  id         String      @id @default(cuid())
  attemptId  String      @unique
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalScore Float
  // Tỷ lệ đúng theo topic/chuyên đề: { topicId: { correct, total, subjectId } }
  topicBreakdown Json
  gradedAt       DateTime @default(now())
}

// ---------- AI cá nhân hóa ----------

model WeaknessAnalysis {
  id        String       @id @default(cuid())
  studentId String
  subjectId String
  attemptId String?
  attempt   ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  // Danh sách chuyên đề yếu kèm chi tiết (tỷ lệ đúng, dạng câu hay sai, ...)
  weakTopics Json
  details    Json?

  generatedAt DateTime @default(now())

  @@index([studentId, subjectId])
}

model StudyRoadmap {
  id        String        @id @default(cuid())
  studentId String
  subjectId String
  status    RoadmapStatus @default(ACTIVE)

  // Các giai đoạn ôn tập: [{ topicId, stage, resourceType, status }, ...]
  stages Json

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, subjectId])
}

// Chụp lại "Điểm sẵn sàng thi" mỗi ngày để vẽ biểu đồ xu hướng — điểm số tự
// nó luôn tính lại được tại chỗ (ReadinessService), bảng này chỉ lưu lịch sử
// theo thời gian mà không thể suy ngược lại từ dữ liệu hiện có. Mỗi ngày chỉ
// giữ 1 bản ghi mới nhất cho mỗi (học sinh, môn) — upsert theo dateKey.
model ReadinessSnapshot {
  id             String @id @default(cuid())
  studentId      String
  student        User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  readinessScore Int
  dateKey        String // YYYY-MM-DD (UTC)

  capturedAt DateTime @default(now())

  @@unique([studentId, subjectId, dateKey])
  @@index([studentId, subjectId])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
